# === 应用配置 ===
APP_NAME=AI Creative Studio
APP_ENV=development
DEPLOYMENT_ENVIRONMENT=development
PRODUCTION_CONFIRMATION=
APP_VERSION=0.2.0
GIT_COMMIT=local
BUILD_TIME=local
DEBUG=false

# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://用户名:密码@主机:5432/数据库名

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === JWT 认证 ===
# 生成方式: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === 文件存储 ===
STORAGE_TYPE=local
# local 模式：本地路径
STORAGE_PATH=./uploads
UPLOADS_PUBLIC_BASE_URL=
# s3/minio 模式时填写
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# === Dify 工作流 ===
DIFY_DEFAULT_BASE_URL=
DIFY_DEFAULT_API_KEY=

# === AI 生图 ===
SEEDREAM_API_KEY=
SEEDREAM_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
GPT_IMAGE2_API_KEY=
GPT_IMAGE2_API_URL=https://api.openai.com/v1/images/generations
DUCKCODING_GPT_IMAGE2_API_KEY=
DUCKCODING_GPT_IMAGE2_API_URL=https://api.duckcoding.ai/v1
AI_TASK_TIMEOUT_SECONDS=1800
AI_TASK_STALE_AFTER_MINUTES=30
AI_TASK_CLEANUP_INTERVAL_SECONDS=60
AI_TASK_WORKER_CONCURRENCY=15
REMOVE_AI_WATERMARKS_ENABLED=true
REMOVE_AI_WATERMARKS_API_URL=http://47.98.127.132/pureimage/watermark-api/remove-watermark
REMOVE_AI_WATERMARKS_TIMEOUT=240
REMOVE_AI_WATERMARKS_STRICT=true
REMOVE_AI_WATERMARKS_MAX_CONCURRENT=4
REMOVE_AI_WATERMARKS_RETRIES=5
REMOVE_AI_WATERMARKS_RETRY_DELAY_SECONDS=5
# 仅旁路记录生图阶段和未知结果，不接管或重复执行生图任务
AI_IMAGE_SHADOW_ENABLED=false
AI_IMAGE_RECONCILIATION_ENABLED=false
AI_IMAGE_RECONCILIATION_INTERVAL_SECONDS=60
AI_IMAGE_RECONCILIATION_BATCH_SIZE=20

# === CORS（前端地址） ===
CORS_ORIGINS=["http://localhost:3000"]

# === 云登 + 小红书 MCP ===
YUNDENG_API_BASE_URL=http://localhost:50213
YUNDENG_CLOUD_API_BASE_URL=https://cloud.yunlogin.com
YUNDENG_CLOUD_OPEN_TOKEN=
XHS_MCP_PORT=18061
# 建议填写绝对路径，避免 PATH 未配置导致启动失败
XHS_MCP_BIN_PATH=/absolute/path/to/xiaohongshu-mcp
XHS_PROFILE_FETCH_TIMEOUT_SECONDS=300
XHS_BROWSER_STOP_COOLDOWN_SECONDS=2
XHS_BROWSER_WS_PROBE_TIMEOUT_SECONDS=3
XHS_BROWSER_START_RETRY_ATTEMPTS=3
XHS_BROWSER_START_RETRY_DELAY_SECONDS=2
XHS_ENABLE_LOCAL_BROWSER_OPS=true
XHS_WORKER_API_BASE_URL=
XHS_YUNDENG_SYNC_CONCURRENCY=5
XHS_YUNDENG_LEASE_SECONDS=1800
XHS_YUNDENG_ACQUIRE_TIMEOUT_SECONDS=3600
XHS_YUNDENG_START_STAGGER_SECONDS=2
XHS_YUNDENG_DISTRIBUTED_COORDINATOR_ENABLED=true
XHS_WORKER_INTERNAL_TOKEN=
XHS_ENABLE_SYNC_TASK_LOOP=false
XHS_ENABLE_ACCOUNT_NOTES_SYNC_LOOP=false
# 仅旁路记录手动主页同步/失败重跑，不接管或重复执行抓取任务
XHS_HOMEPAGE_SYNC_SHADOW_ENABLED=false
XHS_ENABLE_SCHEDULED_PUBLISH_LOOP=true
XHS_REPORT_WORKER_API_BASE_URL=
XHS_REPORT_WORKER_INTERNAL_TOKEN=
XHS_ENABLE_PROFILE_STAT_SYNC_LOOP=false
XHS_PROFILE_STAT_API_BASE_URL=https://ai.youju360.com
XHS_PROFILE_STAT_APP_ID=
XHS_PROFILE_STAT_SECRET=
XHS_PROFILE_STAT_CONFIG_ID=157
XHS_PROFILE_STAT_MODULE=custom_tag
XHS_PROFILE_STAT_SCRIPT=youju
XHS_PROFILE_STAT_DAILY_UPDATE_HOUR=6
XHS_PROFILE_STAT_BACKFILL_DAYS=30
XHS_PROFILE_STAT_SYNC_DELAY_SECONDS=65
XHS_PROFILE_STAT_RETRY_DELAY_SECONDS=305
XHS_PROFILE_STAT_MAX_RETRIES=2

# === 手机验证码中台（第三方签名 Open API） ===
SMS_CODE_CENTER_BASE_URL=http://47.98.127.132
SMS_CODE_CENTER_OPEN_API_CLIENT_ID=
SMS_CODE_CENTER_OPEN_API_CLIENT_SECRET=
# Open API 文档建议 3-5 秒轮询。
SMS_CODE_CENTER_OPEN_API_POLL_INTERVAL_SECONDS=4
# 仅用于本地等待超时，保留旧变量名以兼容现有部署配置。
SMS_CODE_CENTER_ACTIVATION_TTL_SECONDS=300
SMS_CODE_CENTER_SECONDARY_ACTIVATION_TTL_SECONDS=420
# 首次验证码在 180 秒内未进入短信库/通知流时，切换为扫码登录。
SMS_CODE_CENTER_PRIMARY_ATTEMPT_TIMEOUT_SECONDS=180
# 兼容旧部署配置；主短信固定只发一次。
SMS_CODE_CENTER_PRIMARY_SEND_ATTEMPTS=1
# Existing phone-cloud administrator authentication for QR scan tasks. Use the
# static admin token when available; otherwise configure username/password.
# SMS_CODE_CENTER_BUSINESS_API_TOKEN is retained for old deployments only.
SMS_CODE_CENTER_BUSINESS_API_TOKEN=
SMS_CODE_CENTER_ADMIN_API_TOKEN=
SMS_CODE_CENTER_ADMIN_USERNAME=
SMS_CODE_CENTER_ADMIN_PASSWORD=
SMS_DEVICE_LOGIN_LOCK_ENABLED=true
SMS_DEVICE_LOGIN_LOCK_LEASE_SECONDS=1800
SMS_DEVICE_LOGIN_LOCK_ACQUIRE_TIMEOUT_SECONDS=1800
