# === 应用配置 ===
APP_NAME=AI Creative Studio
DEBUG=false

# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://用户名:密码@主机:5432/数据库名

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === JWT 认证 ===
# 生成方式: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === 文件存储 ===
STORAGE_TYPE=local
# local 模式：本地路径
STORAGE_PATH=./uploads
# s3/minio 模式时填写
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# === Dify 工作流 ===
DIFY_DEFAULT_BASE_URL=
DIFY_DEFAULT_API_KEY=

# === AI 生图 ===
SEEDREAM_API_KEY=
SEEDREAM_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations

# === CORS（前端地址） ===
CORS_ORIGINS=["http://localhost:3000"]
