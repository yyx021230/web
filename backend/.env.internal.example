# === 应用配置 ===
APP_NAME=AI Creative Studio
DEBUG=false

# === 数据库（容器网络） ===
DATABASE_URL=postgresql+asyncpg://ai_user:change_me@postgres:5432/ai_creative

# === Redis（容器网络） ===
REDIS_URL=redis://redis:6379/0

# === JWT 认证 ===
# 生成方式: openssl rand -hex 32
JWT_SECRET_KEY=please_replace_with_strong_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === 文件存储 ===
STORAGE_TYPE=local
STORAGE_PATH=/app/uploads

# === AI 生图 ===
SEEDREAM_API_KEY=
SEEDREAM_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
GPT_IMAGE2_API_KEY=
GPT_IMAGE2_API_URL=https://api.openai.com/v1/images/generations

# === Dify 工作流（可选） ===
DIFY_DEFAULT_BASE_URL=
DIFY_DEFAULT_API_KEY=

# === CORS（内网地址） ===
# 示例: CORS_ORIGINS=["http://10.0.0.12:3000","http://10.0.0.13:3000"]
CORS_ORIGINS=["http://127.0.0.1:3000"]
