APP_NAME=AI Creative Studio Test
APP_ENV=test
DEPLOYMENT_ENVIRONMENT=test
PRODUCTION_CONFIRMATION=
APP_VERSION=0.2.0-test
GIT_COMMIT=test
BUILD_TIME=test
DEBUG=false

DATABASE_URL=sqlite+aiosqlite:///./test_ai_creative.db
