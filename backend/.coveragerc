[run]
branch = True
source = app
omit =
    app/scripts/export_prompt_homepage_catalog.py
    app/scripts/replace_prompt_homepage_catalog.py
    app/scripts/curate_business_prompt_catalog.py
    app/scripts/verify_image_count_live.py

[report]
fail_under = 70
show_missing = False
skip_covered = False
precision = 0

[json]
output = coverage.json
