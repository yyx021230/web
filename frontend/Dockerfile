ARG NODE_IMAGE=node:20.19.4-alpine3.22
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM ${NODE_IMAGE} AS builder
ARG BACKEND_ORIGIN=http://backend:8000
ARG NEXT_PUBLIC_API_BASE=/api/backend
ARG NEXT_PUBLIC_APP_VERSION=0.3.8
ARG NEXT_PUBLIC_GIT_COMMIT=unknown
ARG NEXT_PUBLIC_BUILD_TIME=unknown
ENV BACKEND_ORIGIN=${BACKEND_ORIGIN}
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE}
ENV NEXT_PUBLIC_APP_VERSION=${NEXT_PUBLIC_APP_VERSION}
ENV NEXT_PUBLIC_GIT_COMMIT=${NEXT_PUBLIC_GIT_COMMIT}
ENV NEXT_PUBLIC_BUILD_TIME=${NEXT_PUBLIC_BUILD_TIME}
WORKDIR /app
COPY --from=deps /app/node_modules /app/node_modules
COPY . .
RUN npm run build

FROM ${NODE_IMAGE} AS runner
ARG BACKEND_ORIGIN=http://backend:8000
ARG NEXT_PUBLIC_API_BASE=/api/backend
ARG NEXT_PUBLIC_APP_VERSION=0.3.8
ARG NEXT_PUBLIC_GIT_COMMIT=unknown
ARG NEXT_PUBLIC_BUILD_TIME=unknown
ENV BACKEND_ORIGIN=${BACKEND_ORIGIN}
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE}
ENV NEXT_PUBLIC_APP_VERSION=${NEXT_PUBLIC_APP_VERSION}
ENV NEXT_PUBLIC_GIT_COMMIT=${NEXT_PUBLIC_GIT_COMMIT}
ENV NEXT_PUBLIC_BUILD_TIME=${NEXT_PUBLIC_BUILD_TIME}
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
COPY --from=builder /app/.next/standalone /app
COPY --from=builder /app/.next/static /app/.next/static
COPY --from=builder /app/public /app/public

EXPOSE 3000
CMD ["node", "server.js"]
