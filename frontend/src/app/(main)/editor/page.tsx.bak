    { id: 'l3', name: '主标题', type: 'text', canvasId: 'c1', x: 50, y: 80, w: 480, h: 56, angle: 0, opacity: 100, fill: '#0f172a', fontFamily: 'PingFang SC', fontSize: 42, fontWeight: 'bold', fontStyle: 'normal', underline: false, strikethrough: false, textAlign: 'left', lineHeight: 1.2, text: 'AI 创意工作室' },
