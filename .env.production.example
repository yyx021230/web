# Copy to .env on the production host and keep it outside Git.
# Keep the existing Windows production volume names: web_pgdata/web_redisdata/web_miniodata.
COMPOSE_PROJECT_NAME=web
APP_ENV=production
DEPLOYMENT_ENVIRONMENT=production
PRODUCTION_CONFIRMATION=ALLOW_PRODUCTION_DEPLOYMENT

APP_VERSION=0.3.1
GIT_COMMIT=replace_at_deploy
BUILD_TIME=replace_at_deploy
APP_IMAGE_PREFIX=ztqc

POSTGRES_IMAGE=postgres:15.13-alpine
REDIS_IMAGE=redis:7.4.5-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
PYTHON_IMAGE=python:3.11.13-slim-bookworm
NODE_IMAGE=node:20.19.4-alpine3.22

POSTGRES_USER=ai_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=ai_creative
POSTGRES_LOG_MIN_DURATION_MS=1000
POSTGRES_MAX_CONNECTIONS=150
JWT_SECRET_KEY=replace_with_64_character_secret
XHS_WORKER_INTERNAL_TOKEN=replace_with_worker_secret
MINIO_ROOT_USER=replace_with_minio_user
MINIO_ROOT_PASSWORD=replace_with_minio_password
UPLOADS_HOST_PATH=./uploads

STORAGE_TYPE=local
CORS_ORIGINS=["http://127.0.0.1:3000"]
AI_TASK_WORKER_CONCURRENCY=15
XHS_YUNDENG_SYNC_CONCURRENCY=5
XHS_YUNDENG_LEASE_SECONDS=1800
XHS_YUNDENG_ACQUIRE_TIMEOUT_SECONDS=3600
XHS_YUNDENG_START_STAGGER_SECONDS=2
XHS_YUNDENG_DISTRIBUTED_COORDINATOR_ENABLED=true
REMOVE_AI_WATERMARKS_ENABLED=true
REMOVE_AI_WATERMARKS_API_URL=http://47.98.127.132/pureimage/watermark-api/remove-watermark
REMOVE_AI_WATERMARKS_TIMEOUT=240
REMOVE_AI_WATERMARKS_STRICT=true
REMOVE_AI_WATERMARKS_MAX_CONCURRENT=4
REMOVE_AI_WATERMARKS_RETRIES=5
REMOVE_AI_WATERMARKS_RETRY_DELAY_SECONDS=5
AI_IMAGE_SHADOW_ENABLED=false
AI_IMAGE_RECONCILIATION_ENABLED=false
AI_IMAGE_RECONCILIATION_INTERVAL_SECONDS=60
AI_IMAGE_RECONCILIATION_BATCH_SIZE=20
XHS_HOMEPAGE_SYNC_SHADOW_ENABLED=false
XHS_ENGAGEMENT_DETAIL_SYNC_SHADOW_ENABLED=false
XHS_REPORT_REFRESH_SHADOW_ENABLED=false
DIFY_TASK_SHADOW_ENABLED=false
SCHEDULER_LEADER_ENABLED=true
SCHEDULER_LEADER_LEASE_SECONDS=30
SCHEDULER_LEADER_HEARTBEAT_SECONDS=10

LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
POSTGRES_MEMORY_LIMIT=4g
REDIS_MEMORY_LIMIT=2g
MINIO_MEMORY_LIMIT=2g
BACKEND_MEMORY_LIMIT=6g
AI_WORKER_MEMORY_LIMIT=12g
FRONTEND_MEMORY_LIMIT=2g
