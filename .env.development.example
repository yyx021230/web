# Copy to .env.development. This file is for local containers only.
COMPOSE_PROJECT_NAME=ztqc-web-dev
APP_ENV=development
DEPLOYMENT_ENVIRONMENT=development
PRODUCTION_CONFIRMATION=
APP_VERSION=0.3.0-dev
GIT_COMMIT=local
BUILD_TIME=local

POSTGRES_USER=ai_dev
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=ai_creative_dev
JWT_SECRET_KEY=replace_with_local_jwt_secret
XHS_WORKER_INTERNAL_TOKEN=replace_with_local_worker_token
MINIO_ROOT_USER=dev_minio
MINIO_ROOT_PASSWORD=replace_with_local_minio_password
UPLOADS_HOST_PATH=./runtime/development/uploads

STORAGE_TYPE=local
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AI_TASK_WORKER_CONCURRENCY=3
AI_IMAGE_SHADOW_ENABLED=false
AI_IMAGE_RECONCILIATION_ENABLED=false
AI_IMAGE_RECONCILIATION_INTERVAL_SECONDS=60
AI_IMAGE_RECONCILIATION_BATCH_SIZE=20
XHS_HOMEPAGE_SYNC_SHADOW_ENABLED=false
XHS_ENGAGEMENT_DETAIL_SYNC_SHADOW_ENABLED=false
XHS_REPORT_REFRESH_SHADOW_ENABLED=false
DIFY_TASK_SHADOW_ENABLED=false
SCHEDULER_LEADER_ENABLED=true
SCHEDULER_LEADER_LEASE_SECONDS=30
SCHEDULER_LEADER_HEARTBEAT_SECONDS=10
